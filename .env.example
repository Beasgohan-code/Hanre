# Optional — raises the GitHub rate limit for repository imports.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Optional — only needed behind a TLS-inspecting proxy (corporate networks, sandboxes).
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Optional — database location (defaults to ./data/hanre.db).
# For Docker, mount a persistent volume at /app/data and use HANRE_DB_PATH=/app/data/hanre.db.
# HANRE_DB_PATH=./data/hanre.db

# Production only: explicitly opt in to the public demo account (not recommended).
# HANRE_ENABLE_DEMO=false
